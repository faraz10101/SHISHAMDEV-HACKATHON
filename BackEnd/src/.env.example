PORT=5000
# Database name must be Scam-Shield-database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/Scam-Shield-database?retryWrites=true&w=majority

# --- Auth (from the old app) ---
JWT_SECRET=change-me-to-a-long-random-string
RESEND_API_KEY=re_xxxxxxxxxxxx
# Must be an address on a domain you verified in Resend
EMAIL_FROM=ScamShield <noreplya.relic@codeera.me>
APP_NAME=ScamShield
# Optional: public URL of a logo image to show in the email header (text header is used if empty)
EMAIL_LOGO_URL=
# Cookie SameSite: lax (same site / local dev) or none (frontend and API on different domains, needs https). Default: lax in dev, none in production.
COOKIE_SAMESITE=

# Long random strings. Keep ENCRYPTION_SECRET stable: it decrypts the AI keys stored in the DB.
ENCRYPTION_SECRET=change-me-to-a-long-random-string
ADMIN_KEY=change-me-to-another-long-random-string
# Salt for the anonymous reporter hash. Keep it stable once real reports exist.
SALT=change-me-random-salt-for-reporter-hash
# Frontend URL(s), comma separated. Leave empty to allow all origins (dev only).
CLIENT_ORIGIN=http://localhost:5173
# Dev only: lets one account report the same number repeatedly while testing
ALLOW_REPEAT_REPORTS=false

# One-time bootstrap (npm run providers). Delete these after running it.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GROQ_API_KEY=
OPENROUTER_API_KEY=
